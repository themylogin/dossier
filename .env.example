# API keys of your Telegram app, from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Phone number of the account, with the country code
TELEGRAM_PHONE=
# Host folder for the database
DATA_DIR=./data
# Host folder for downloaded media
DOWNLOADS_DIR=./downloads
# URL of the OpenClaw Gateway
OPENCLAW_URL=
# The hooks.token of the OpenClaw config
OPENCLAW_HOOK_TOKEN=
# Agent that gets the requests; empty for the default agent
OPENCLAW_AGENT_ID=
# Folder on this machine for the chat exports, shared with the OpenClaw machine
OPENCLAW_EXPORT_DIR=./exports
# The same folder as the OpenClaw agent sees it
OPENCLAW_EXPORT_PATH=
